# Required for LLM planning / interpretation
GROQ_API_KEY=your_groq_api_key_here

# Optional overrides
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0

# Optional execution bounds
MAX_FILE_SIZE_MB=10
MAX_SESSION_SIZE_MB=50
MAX_RESULT_ROWS=200
MAX_LLM_RESULT_ROWS=50
MAX_SQL_CORRECTION_RETRIES=1
MAX_ANALYTICAL_QUERIES=3
